# vi: ft=nginx

### Redirects ###
server {
    listen         80;
    listen    [::]:80;
    server_name    $HOSTNAME $HOSTNAME;
    return         301 https://$HOSTNAME$request_uri;
}

# Change naked domain to www
server {
    listen          443 ssl;
    listen     [::]:443 ssl;
    http2           on;
    server_name     $HOSTNAME;

    include snippets/ssl.conf;
    include snippets/headers.conf;
    resolver 127.0.0.1 [::1];

    rewrite         ^ https://$HOSTNAME$request_uri;
}


### Servers ###

server {
    listen          443 ssl default_server;
    listen     [::]:443 ssl default_server;
    http2           on;
    server_name     $HOSTNAME;
    access_log      /var/log/nginx/$PROJECT_NAME/$PROJECT_NAME.access.log;
    error_log       /var/log/nginx/$PROJECT_NAME/$PROJECT_NAME.error.log;

    include snippets/ssl.conf;
    include snippets/gzip.conf;
    # Included at the server level so that locations which add no headers of
    # their own still inherit the security headers.  A location that declares
    # any add_header must include this snippet again -- see headers.conf.
    include snippets/headers.conf;
    resolver 127.0.0.1 [::1];

    location / {
        proxy_pass       http://127.0.0.1:$INTERNAL_PORT;
        proxy_buffering  off;
        # Cache-Control is left to the application: a blanket public cache here
        # would let an intermediary store and replay per-user responses.
    }

    location /static/ {
        include          snippets/headers.conf;
        alias            $REPO_PATH/static/mount/;
        add_header       'Access-Control-Allow-Origin'   'https://www.$HOSTNAME';
        add_header       'Access-Control-Allow-Methods'  'GET, HEAD, OPTIONS';
        add_header       'Access-Control-Allow-Headers'  'range';
        add_header       'Access-Control-Expose-Headers' 'content-length';
        add_header       'Access-Control-Max-Age'        '1728000';
        add_header       'Cache-Control'                 'public';
        expires          24h;
    }
}
